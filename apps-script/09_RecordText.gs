/**
 * Trail Journal -- Apps Script backend
 * File 9: the full written report, server-side. GENERATED by tools/port-record-text.js from
 * buildEmailBody() in index.html -- do not edit here; edit the page and run the tool again.
 * S = the journal fields the page keeps in its S object (see recordState_ in 10_Records.gs).
 */

const LOCATION_TIER_ = {
  'Lunch Detention': 'detention',
  'Morning Detention': 'detention',
  'Afterschool Detention': 'detention',
  // The student still picks their actual incident location (e.g. Cafeteria, or one of the
  // Removal-from-Lunch-specific cafeteria sub-locations) on Part 1's "Where did it happen?"
  // dropdown, which already drives the Peaks reference card independently of this
  // welcome-screen consequence picker -- see WHERE_OPTIONS_REMOVAL_FROM_LUNCH_ below.
  'Removal from Lunch': 'detention',
  'Office': 'detention',
  // ISS and Camp Mountaineer both route into the Camp Mountaineer pre-page (screen-cm)
  // before Part 1 -- the tier value set here is only a placeholder until the student
  // picks their actual pathway there, which re-sets S.tier via CM_REASON_TIER_.
  'ISS': 'full',
  'Camp Mountaineer': 'full',
  'Other': 'full', // safest default when the location doesn't fit cleanly -- full asks
                    // for more than a shorter tier would, never less than needed.
};
const CM_REASON_TIER_ = {
  'Break': 'office',
  'Re-entry': 'office',
  'ISS': 'full',
  'New Student': 'office',
  'Privilege': 'office',
  'Conference / Meeting': 'office',
  'Removed from Class': 'office',
};
const CM_REASON_REQUIRES_EFFORT_ = 'ISS';

function buildRecordText_(S, result, p1, p2, p3) {
  // LRG resource bank — from Drive: LRG Glows & Grows, Prompt Calendar, Behavior Buckets
  const LRG_RESOURCES = {
    'Communication & Empathy': {
      lookFors: ['Active Listening', 'Meaningful Inquiry', 'Audience Awareness', 'Clear Purpose'],
      prompts: ["How do you show someone you're really listening?", "When has someone shown you empathy?", "How do you handle misunderstandings?"],
      strategies: ['Looping technique (Ask → Repeat → Check → Next Step)', 'Affective statements using I-language', 'Role-play perspective-taking conversations'],
      bucket: 'Connection — Trust, Respect, Authenticity (Creekmore & Creekmore)',
      bucketSkill: 'Social Thinking — reading nonverbal cues, empathizing, understanding impact on others (Ablon)',
    },
    'Honesty, Integrity, & Responsibility': {
      lookFors: ['Truthfulness under pressure', 'Ownership of actions', 'Follow-through on commitments'],
      prompts: ["What does it mean to do the right thing when no one is watching?", "When have you taken responsibility for a mistake?", "How do you show others they can trust you?"],
      strategies: ['Implementation Intention (When X happens, I will Y)', 'PAIR reframing (Pause-Acknowledge-Investigate-Reframe)', 'Restorative questions for accountability'],
      bucket: 'Awareness — Conscious Competence Ladder (Unconscious Incompetence → Unconscious Competence)',
      bucketSkill: 'Cognitive Flexibility — handling deviations from plans, interpreting situations accurately (Ablon)',
    },
    'Critical Thinking & Problem Solving': {
      lookFors: ['Gathering Information', 'Analyzing Information', 'Identifying Solutions', 'Taking Action', 'Reflecting'],
      prompts: ["What helps you stay calm when solving a tough problem?", "How do you know when you've made a fair decision?", "Describe a situation where thinking carefully made a difference."],
      strategies: ['Forward Story (describe what you want at 25, identify obstacles)', 'Cognitive reframing — shades of gray vs. black/white thinking', 'CPS collaborative problem solving framework'],
      bucket: 'Skills — Attention and Working Memory, Cognitive Flexibility (Ablon)',
      bucketSkill: 'Attention and Working Memory — considering range of solutions, reflecting on multiple ideas simultaneously',
    },
    'Healthy Living, Wellness, & Self-Awareness': {
      lookFors: ['Recognizing emotional triggers', 'Body-mind connection', 'Self-regulation under stress'],
      prompts: ["What does your body or brain tell you when you're stressed?", "What's one habit that helps you feel your best?", "What helps you refocus after a setback?"],
      strategies: ['Meta-Moment (pause before reacting)', 'Mindful Breathing 7-11', 'Trigger Mapping — identifying specific people/places/situations that activate fight/flight'],
      bucket: 'Regulation — Physical, Emotional, Cognitive (Brummer/Sorrels)',
      bucketSkill: 'Emotion & Self-Regulation Skills — managing irritability, anxiety, disappointment in age-appropriate ways (Ablon)',
    },
    'Adaptability & Flexibility': {
      lookFors: ['Handling transitions smoothly', 'Gray-area thinking', 'Adjusting to unpredictability'],
      prompts: ["How do you react when plans change suddenly?", "Describe a time when you had to go with the flow.", "What does it mean to be flexible without losing focus?"],
      strategies: ['Attention Shifting — physically redirecting focus away from trigger', 'Implementation Intention for change scenarios', 'Forward Story — long-term thinking vs. short-term reaction'],
      bucket: 'Regulation — Cognitive & Emotional (Brummer/Sorrels)',
      bucketSkill: 'Cognitive Flexibility Skills — handling deviations from rules/routines, thinking hypothetically (Ablon)',
    },
    'Resilience & Grit': {
      lookFors: ['Pushing through adversity', 'Bouncing back from failure', 'Growth mindset under pressure'],
      prompts: ["What's something hard you've pushed through?", "How do you bounce back from a bad day?", "What's your strategy when you want to give up?"],
      strategies: ['Forward Story (describe future self at 25)', 'Pat Heart & Stomach for regulation (Ruby Payne)', 'Hope Staircase — Goals, Pathways, Agency (Snyder)'],
      bucket: 'Regulation — Pro-Social & Emotional (Brummer/Sorrels)',
      bucketSkill: 'Emotion & Self-Regulation Skills — managing disappointment, adjusting arousal level to demands',
    },
    'Collaborative & Teamwork': {
      lookFors: ['Collaboration', 'Dynamics', 'Compromise', 'Accountability'],
      prompts: ["What's your role in a group project?", "What makes a team successful?", "How do you show others you value their ideas?"],
      strategies: ['Looping for genuine perspective-getting', 'Restorative circle questions', 'Affective statements — sharing impact without blame'],
      bucket: 'Connection — Trust & Respect (Creekmore & Creekmore)',
      bucketSkill: 'Social Thinking — understanding impact on others, empathy, entering groups appropriately (Ablon)',
    },
    'Continual Learning & Growth Mindset': {
      lookFors: ['Openness to feedback', 'Learning from mistakes', 'Effort over fixed ability beliefs'],
      prompts: ["What's something you've learned to do that you once thought was too hard?", "How do you respond when something doesn't go your way?", "What's one thing you want to get better at this month?"],
      strategies: ['Conscious Competence Ladder — identify where student is, name the stage', 'Cognitive reframing of failure as data', 'Implementation Intention for building practice habits'],
      bucket: 'Awareness — Conscious Competence Ladder',
      bucketSkill: 'Cognitive Flexibility — thinking hypothetically, handling unpredictability, shifting from original plan',
    },
    'Creativity & Innovation': {
      lookFors: ['Original Ideas', 'Techniques', 'Iteration', 'Implementation'],
      prompts: ["How do you get inspired when working on a creative task?", "What's a unique idea you've had?", "Where do you do your best thinking?"],
      strategies: ['Brainstorming without judgment', 'Design thinking iteration loop', 'Forward Story — imagining multiple possibilities for the future'],
      bucket: 'Skills — Language & Communication, Attention and Working Memory',
      bucketSkill: 'Attention and Working Memory — generating original ideas, considering a range of solutions simultaneously',
    },
    'Civics, Leadership, & Service': {
      lookFors: ['Community awareness', 'Taking initiative', 'Service orientation'],
      prompts: ["What does leadership mean to you?", "How can one person make a difference?", "What would you change about your school or community?"],
      strategies: ['Restorative practices approach — repair through service', 'Pro-Social Regulation — empathizing and acting on it (Brummer)', 'Affective statements directed at community members'],
      bucket: 'Connection — Authenticity & Respect (Creekmore & Creekmore)',
      bucketSkill: 'Pro-Social Regulation — capacity to empathize and act in caring ways toward others distress (Brummer/Sorrels)',
    },
  };

  const resources = LRG_RESOURCES[p3.trait] || {};

  const blockIntro = [
    'CAMP MOUNTAINEER — TRAIL JOURNAL STAFF SUMMARY',
    'Generated: ' + new Date().toLocaleString(),
    'Student: ' + (S.name || S.initial || '—') + (S.grade ? ' (Grade ' + S.grade + ')' : ''),
    (S.squad ? 'Squad: ' + S.squad : ''),
    (S.team ? 'Team: ' + S.team : ''),
    (S.location ? 'Location: ' + S.location : ''),
    (S.peak ? 'Mountaineer Peaks Area: ' + S.peak : ''),
    (S.cmReason ? 'Camp Mountaineer Pathway: ' + S.cmReason : ''),
    (S.cmInitiatedBy ? 'Initiated By: ' + S.cmInitiatedBy : ''),
    (S.cmWhy ? 'Reason Given: ' + S.cmWhy : ''),
    (S.cmReason === CM_REASON_REQUIRES_EFFORT_ ? 'Student Checklist Confirmed: ' + (S.cmChecklistAgreed ? 'Yes' : 'No') : ''),
    (S.cmReason === CM_REASON_REQUIRES_EFFORT_ ? 'Effort Agreement Confirmed: ' + (S.cmEffortAgreed ? 'Yes' : 'No') : ''),
  ].filter(Boolean).join('\n');

  // Full prose case narrative -- the AI's fuller "in addition to the key information"
  // write-up, distinct from the terse 2-3 sentence summary below. Placed right after the
  // intro so staff read the whole story first, then the quick-reference structured data.
  const blockNarrative = result.narrativeReport
    ? ['=== STUDENT NARRATIVE REPORT ===', result.narrativeReport].join('\n')
    : '';

  const blockIncident = [
    '=== INCIDENT & REPAIR SUMMARY (Part 1-2) ===',
    result.summary || '—',
    '',
    'Insight Level: ' + (result.insightLevel || '—'),
    result.insightReason || '',
  ].filter(Boolean).join('\n');

  // Separate from blockIncident above on purpose -- this is Part 3's forward-looking
  // growth/environment piece (trait + creative product + community action), not a repeat
  // of the repair summary. Only exists for the full tier, where Part 3 was collected.
  const blockGrowthSummary = result.growthSummary
    ? ['=== GROWTH & ENVIRONMENT IMPACT SUMMARY (Part 3) ===', result.growthSummary].join('\n')
    : '';

  const blockHope = result.hopeNote ? ['=== HOPE & AGENCY ===', result.hopeNote].join('\n') : '';

  const blockWhatHappened = [
    '=== WHAT HAPPENED ===',
    'Situation: ' + (p1.whatHappened || '—'),
    'Why: ' + (p1.why || '—'),
    'Thinking at the time: ' + (p1.thinking || '—'),
    'Emotions during (' + (p1.intensityDuring || '—') + '/5): ' + (p1.emotionsDuring || []).join(', '),
    'Emotions now (' + (p1.intensityNow || '—') + '/5): ' + (p1.emotionsNow || []).join(', '),
    'CPS — What was going on before: ' + (p1.cpsUnsolvedProblem || '—'),
    'CPS — What they cared about: ' + (p1.cpsMyConcern || '—'),
    'CPS — What the other person cared about: ' + (p1.cpsTheirConcern || '—'),
    'Part 1 Takeaway: ' + (p1.takeaway || '—'),
  ].join('\n');

  const blockMakingRight = [
    '=== MAKING THINGS RIGHT ===',
    'People hurt: ' + (p2.hurtPeople || []).join(', '),
    'What student thinks should happen: ' + (p2.makeRight || '—'),
    'Consequence choices ranked: ' + (p2.selectedConsequences || []).join(' → '),
    'Best idea: ' + (p2.bestIdea || '—'),
    'Plan: ' + (p2.plan || '—'),
    'Will do differently: ' + (p2.different || '—'),
    ...(p2.creativeChallenge ? ['Creative challenge response: ' + p2.creativeChallenge] : []),
  ].join('\n');

  const blockGrowthPlan = [
    '=== GROWTH PLAN ===',
    'LRG Trait: ' + (p3.trait || '—'),
    'Specific areas: ' + (p3.traitSpecifics || []).join(', '),
    'Why this trait: ' + (p3.traitWhy || '—'),
    'Creative format: ' + (p3.creativeFormat || '—'),
    'Creative plan: ' + (p3.creativePlan || '—'),
    ...(p3.communityAction ? ['Community/Service Action: ' + p3.communityAction] : []),
  ].join('\n');

  const blockConsequences = (result.recommendedConsequences && result.recommendedConsequences.length)
    ? ['=== RECOMMENDED CONSEQUENCES ===', ...result.recommendedConsequences.map(c => c.type + ': ' + c.description + '\n  Rationale: ' + c.rationale)].join('\n')
    : '';

  const blockRepairPlan = ['=== REPAIR PLAN ===', result.repairPlan || '—'].join('\n');

  const blockStudentGoal = ['=== STUDENT GOAL ===', result.studentGoal || '—'].join('\n');

  const blockRestorativeQ = (result.restorativeQuestions && result.restorativeQuestions.length)
    ? ['=== RESTORATIVE QUESTIONS ===', ...result.restorativeQuestions.map((q, i) => (i + 1) + '. ' + q)].join('\n')
    : '';

  const blockCpsScript = (result.cpsScript && result.cpsScript.length)
    ? ['=== CPS CONFERENCE SCRIPT ===', ...result.cpsScript.map(l => l.speaker + ': "' + l.text + '"')].join('\n')
    : '';

  const blockFollowUpFlags = (result.followUpFlags && result.followUpFlags.length)
    ? ['=== FOLLOW-UP FLAGS ===', ...result.followUpFlags.map(f => '⚠️ ' + f)].join('\n')
    : '';

  const blockResourceBank = [
    '=== LRG RESOURCE BANK — ' + (p3.trait || 'TRAIT').toUpperCase() + ' ===',
    'Behavior Bucket: ' + (resources.bucket || '—'),
    'Lagging Skill Area: ' + (resources.bucketSkill || '—'),
    '',
    'Look Fors (LRG Glows & Grows Rubric):',
    ...(resources.lookFors || []).map(l => '  • ' + l),
    '',
    'Suggested Follow-Up Prompts (Camp Mountaineer Prompt Calendar):',
    ...(resources.prompts || []).map(p => '  • ' + p),
    '',
    'Recommended Strategies:',
    ...(resources.strategies || []).map(s => '  • ' + s),
    ...(result.studentReadingList && result.studentReadingList.length
      ? ['', 'AI-Selected Reading List (possible titles only -- review each one and use your professional judgement before sharing; not for the student to read unsupervised):', ...result.studentReadingList.map(r => '  • ' + r.title + (r.topic ? ' — ' + r.topic : '') + '\n    ' + r.whyRelevant)]
      : []),
    ...(result.practicePlan
      ? ['', 'Weekly Practice Plan:', ...(result.practicePlan.days || []).map(d => '  ' + d.day + ': ' + d.task)]
      : []),
  ].join('\n');

  const blockClash = (result.insightLevel === 'High' && S.squad)
    ? '🏆 Clash of Classes: flagged for a possible +1 point to ' + S.squad + ' Squad — pending staff review on the admin Clash Flags page.'
    : '';

  // Every raw answer, verbatim, labeled -- separate from the AI-written narrative/summary
  // blocks above (which paraphrase and select what's relevant). This is the actual data:
  // nothing summarized, nothing dropped, so the office record email is a genuine full
  // report even if the AI summary above missed or compressed something. Part 3 fields
  // only appear for the 'full' tier, where Part 3 was actually collected.
  const blockFullReflection = [
    '=== 📝 FULL REFLECTION — EVERY ANSWER, VERBATIM ===',
    '--- Part 1: What Happened ---',
    'What happened: ' + (p1.whatHappened || '—'),
    'Who else was involved: ' + (p1.whoInvolved || '—'),
    'Who witnessed it: ' + (p1.witnesses || '—'),
    'Where: ' + (p1.where || '—'),
    'When / what were you doing: ' + (p1.when || '—'),
    'What were you thinking: ' + (p1.thinking || '—'),
    (p1.repeatCount ? 'How many times asked to finish lunch in this area: ' + p1.repeatCount : ''),
    'Why did you do it: ' + (p1.why || '—'),
    'Emotions during (' + (p1.intensityDuring || '—') + '/5): ' + (p1.emotionsDuring || []).join(', '),
    'Emotions now (' + (p1.intensityNow || '—') + '/5): ' + (p1.emotionsNow || []).join(', '),
    'Did emotions change: ' + (p1.emotionChange === 'yes' ? 'Yes' : p1.emotionChange === 'no' ? 'No' : '—'),
    'Why (or why not): ' + (p1.emotionChangeReason || '—'),
    'Crossing Paths — what was going on before: ' + (p1.cpsUnsolvedProblem || '—'),
    'Crossing Paths — what I cared about: ' + (p1.cpsMyConcern || '—'),
    'Crossing Paths — what they cared about: ' + (p1.cpsTheirConcern || '—'),
    '',
    '--- Part 2: Making Things Right ---',
    'People hurt: ' + (p2.hurtPeople || []).join(', '),
    'What should happen: ' + (p2.makeRight || '—'),
    'Consequences chosen (ranked): ' + (p2.selectedConsequences || []).join(' → '),
    'Best idea: ' + (p2.bestIdea || '—'),
    'Follow-through plan: ' + (p2.plan || '—'),
    'What I\'ll do differently: ' + (p2.different || '—'),
    (p2.creativeChallenge ? 'Creative challenge response: ' + p2.creativeChallenge : ''),
    ...(S.tier === 'full' ? [
      '',
      '--- Part 3: Growth Plan ---',
      'LRG Trait: ' + (p3.trait || '—'),
      'Specific areas: ' + (p3.traitSpecifics || []).join(', '),
      'Why this trait: ' + (p3.traitWhy || '—'),
      'Skill strategy: ' + (p3.selectedSkill ? (p3.selectedSkill.domain + ' — ' + p3.selectedSkill.strategy) : '—'),
      'Creative format: ' + (p3.creativeFormat || '—'),
      'Creative plan: ' + (p3.creativePlan || '—'),
      (p3.communityAction ? 'Community/service action: ' + p3.communityAction : ''),
      'Follow-through — when: ' + (p3.followThrough?.when || '—'),
      'Follow-through — needs: ' + (p3.followThrough?.needs || '—'),
      'Follow-through — audience: ' + (p3.followThrough?.audience || '—'),
      'Follow-through — if stuck: ' + (p3.followThrough?.stuckPlan || '—'),
      'Hope level (1-4, "Where are you right now?"): ' + (p3.hopeLevel != null ? p3.hopeLevel : '—'),
      'What would make this feel fair: ' + (p3.fairReflect || '—'),
    ] : []),
  ].filter(Boolean).join('\n');

  const blocks = [
    blockIntro, blockNarrative, blockIncident, blockGrowthSummary, blockHope, blockWhatHappened, blockMakingRight,
    blockGrowthPlan, blockConsequences, blockRepairPlan, blockStudentGoal,
    blockRestorativeQ, blockCpsScript, blockFollowUpFlags, blockResourceBank, blockClash, blockFullReflection,
  ];

  // Every real section is now a single joined string with its own header baked in, and
  // sections that don't apply (no hope note, no follow-up flags, etc.) are '' and get
  // dropped here -- filtering the finished blocks, not individual spacer lines, is what
  // guarantees a real blank line between every section below. The previous version's
  // final .filter(Boolean) ran on the flat line array, which silently ate every
  // intentional blank-line spacer along with the empty optional lines -- so every
  // section ran straight into the next with no separation at all. That's the main
  // reason the summary read as a wall of text.
  return blocks.filter(Boolean).join('\n\n');
}
